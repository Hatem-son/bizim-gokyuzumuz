# İstemci (Vite / Vercel Environment Variables)
# Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://PROJE-ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Web Push VAPID Public Key (push bildirimleri için: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# Supabase Edge Function Secrets (yalnızca Supabase Dashboard -> Edge Functions -> Secrets)
# APP_ORIGIN=https://uygulaman.vercel.app
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:senin@mailin.com
